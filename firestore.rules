rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== ROOT-LEVEL COLLECTION GROUP RULES =====
    // Collection-group reads use document data because no organization path
    // variable is available at this match level.
    match /{path=**}/pallets/{palletId} {
      allow list: if isAuthorizedPallet(resource.data) && isBoundedPalletQuery();
    }

    // ===== HELPER FUNCTIONS =====

    // Get user membership for an organization
    function getUserMembership(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid));
    }

    // Check if user is member of organization
    function isMemberOf(orgId) {
      let membership = getUserMembership(orgId);
      // Firestore rules DocumentSnapshot exposes data; it does not expose an
      // `exists` property. A missing document has null data.
      return request.auth != null && membership.data != null &&
        membership.data.userId == request.auth.uid &&
        membership.data.organizationId == orgId &&
        membership.data.status == 'ACTIVE' &&
        membership.data.role in [
          'SUPER_ADMIN', 'ADMIN', 'GERENTE_ALMACEN',
          'AUXILIAR_ALMACENISTA', 'ALMACENISTA', 'AUDITOR', 'OPERATOR', 'SUPERVISOR'
        ];
    }

    // Check if user has specific role(s)
    function hasRole(orgId, roles) {
      let membership = getUserMembership(orgId);
      return isMemberOf(orgId) && membership.data.role in roles;
    }

    // Warehouse IDs are stable references. Display names must not be used as IDs.
    function isCanonicalWarehouseId(warehouseId) {
      return warehouseId is string && warehouseId in [
        'wh_tehuacan_1', 'wh_tehuacan_2', 'piloto-1'
      ];
    }

    // Membership records written by older clients may still contain display
    // names or legacy warehouse codes. Requests themselves must always use
    // canonical warehouse IDs; aliases are accepted only when comparing a
    // membership's stored scope to that canonical request ID.
    function membershipWarehouseMatches(legacyOrCanonicalId, canonicalId) {
      return legacyOrCanonicalId is string && (
        (canonicalId == 'wh_tehuacan_1' &&
          legacyOrCanonicalId in [
            'wh_tehuacan_1', 'Tehuacan-1', 'ALM-001', 'almacen-001', 'warehouse-1'
          ]) ||
        (canonicalId == 'wh_tehuacan_2' &&
          legacyOrCanonicalId in [
            'wh_tehuacan_2', 'Tehuacan-2', 'ALM-002', 'almacen-002', 'warehouse-2'
          ]) ||
        (canonicalId == 'piloto-1' &&
          legacyOrCanonicalId in [
            'piloto-1', 'Piloto-1', 'piloto1', 'pilot1'
          ])
      );
    }

    function isUserCreatedWarehouseId(warehouseId) {
      return warehouseId is string && warehouseId.matches('^ALM-\\d{3}$');
    }

    function isValidWarehouseId(warehouseId) {
      return isCanonicalWarehouseId(warehouseId) || isUserCreatedWarehouseId(warehouseId);
    }

    // Check warehouse access (null warehouseId = access to all)
    function canAccessWarehouse(orgId, warehouseId) {
      let membership = getUserMembership(orgId);
      return isValidWarehouseId(warehouseId) && isMemberOf(orgId) && (
        membership.data.role in ['SUPER_ADMIN', 'ADMIN'] ||
        (membership.data.warehouseId != null &&
          membershipWarehouseMatches(membership.data.warehouseId, warehouseId)) ||
        (membership.data.warehouseIds is list &&
          ((warehouseId == 'wh_tehuacan_1' && membership.data.warehouseIds.hasAny([
            'wh_tehuacan_1', 'Tehuacan-1', 'ALM-001', 'almacen-001', 'warehouse-1'
          ])) ||
          (warehouseId == 'wh_tehuacan_2' && membership.data.warehouseIds.hasAny([
            'wh_tehuacan_2', 'Tehuacan-2', 'ALM-002', 'almacen-002', 'warehouse-2'
          ])) ||
          (warehouseId == 'piloto-1' && membership.data.warehouseIds.hasAny([
            'piloto-1', 'Piloto-1', 'piloto1', 'pilot1'
          ]))))
      );
    }

    function isAuthorizedPallet(data) {
      return request.auth != null && data.organizationId is string &&
        data.warehouseId is string && isMemberOf(data.organizationId) &&
        canAccessWarehouse(data.organizationId, data.warehouseId);
    }

    // Pagination bound only; authorization is independently enforced above.
    function isBoundedPalletQuery() {
      return request.query.limit is int && request.query.limit > 0 &&
        request.query.limit <= 43;
    }

    // Operational records must remain assigned to their original warehouse.
    function warehouseAssignmentUnchanged() {
      return !('warehouseId' in resource.data) ||
        ('warehouseId' in request.resource.data &&
          request.resource.data.warehouseId == resource.data.warehouseId);
    }

    // A role check alone is not an integrity check. Every state transition
    // must explicitly limit the fields that can change.
    function hasOnlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function shipmentClaimUnchanged() {
      return (!('shipmentId' in resource.data) && !('shipmentId' in request.resource.data)) ||
        ('shipmentId' in resource.data && 'shipmentId' in request.resource.data &&
          request.resource.data.shipmentId == resource.data.shipmentId);
    }

    // Role checks
    function isOrgAdmin(orgId) {
      return hasRole(orgId, ['SUPER_ADMIN', 'ADMIN']);
    }

    function isSupervisorOrAdmin(orgId) {
      return hasRole(orgId, ['GERENTE_ALMACEN', 'SUPERVISOR', 'SUPER_ADMIN', 'ADMIN']);
    }

    function isOperatorOrAbove(orgId) {
      return hasRole(orgId, [
        'AUXILIAR_ALMACENISTA', 'ALMACENISTA', 'OPERATOR', 'GERENTE_ALMACEN',
        'SUPERVISOR', 'SUPER_ADMIN', 'ADMIN'
      ]);
    }

    // Check if user is the actor who created the document
    function isActor(orgId, actorUserId) {
      return request.auth.uid == actorUserId;
    }

    // ===== ORGANIZATIONS =====
    match /organizations/{orgId} {
      // Members can read their organization
      allow read: if isMemberOf(orgId);

      // Only admins can create/update organization
      allow create: if isOrgAdmin(orgId) ||
        (request.auth != null && request.auth.token.admin == true);
      allow update: if isOrgAdmin(orgId);
      allow delete: if isOrgAdmin(orgId);

      // ===== WAREHOUSES =====
      match /warehouses/{warehouseId} {
        allow read: if isValidWarehouseId(warehouseId) && isMemberOf(orgId);
        allow create: if isValidWarehouseId(warehouseId) &&
          isOrgAdmin(orgId) &&
          request.resource.data.id == warehouseId &&
          request.resource.data.organizationId == orgId;
        allow update: if isValidWarehouseId(warehouseId) &&
          isOrgAdmin(orgId) &&
          resource.data.id == warehouseId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.organizationId == orgId;
        allow delete: if isValidWarehouseId(warehouseId) && isOrgAdmin(orgId);
      }

      // ===== USERS (MEMBERSHIPS) =====
      match /users/{userId} {
        // The owner may read status before ACTIVE, but cannot list memberships.
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if isMemberOf(orgId);
        // Admin-only creation: an org admin provisions a membership FOR another
        // user. This closes cross-tenant sign-up - a caller can no longer
        // self-provision into an attacker-chosen orgId, and role/status/warehouse
        // scope can never be self-elevated because creation is gated on
        // isOrgAdmin(orgId) (one membership get, already required for reads).
        allow create: if isOrgAdmin(orgId)
          && request.resource.data.keys().hasOnly([
               'userId', 'organizationId', 'role', 'status',
               'warehouseId', 'warehouseIds', 'displayName', 'email'
             ])
          && request.resource.data.userId is string
          && request.resource.data.userId.size() >= 1
          && request.resource.data.userId.size() <= 128
          && request.resource.data.organizationId == orgId
          && request.resource.data.status in ['ACTIVE', 'INACTIVE']
          && request.resource.data.role in [
            'SUPER_ADMIN', 'ADMIN', 'GERENTE_ALMACEN',
            'SUPERVISOR', 'AUXILIAR_ALMACENISTA', 'ALMACENISTA', 'AUDITOR', 'OPERATOR'
          ]
          && (!('warehouseId' in request.resource.data) ||
              (request.resource.data.warehouseId == null ||
                (request.resource.data.warehouseId is string &&
                 request.resource.data.warehouseId.size() <= 100)))
          && request.resource.data.warehouseIds is list
          && request.resource.data.warehouseIds.size() >= 1
          && request.resource.data.warehouseIds.size() <= 20
          && (!('displayName' in request.resource.data) ||
              (request.resource.data.displayName is string &&
               request.resource.data.displayName.size() <= 120))
          && (!('email' in request.resource.data) ||
              (request.resource.data.email is string &&
               request.resource.data.email.size() <= 254));
        // Admins own the membership lifecycle. The owner may only reconcile
        // their own display fields (display names arrive asynchronously from
        // Firebase Auth after the profile was provisioned), so role, status
        // and warehouse scope can never be self-elevated.
        allow update: if isOrgAdmin(orgId)
          || (request.auth != null && request.auth.uid == userId
              && resource.data.userId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['displayName', 'email'])
              && (!('displayName' in request.resource.data) ||
                  (request.resource.data.displayName is string &&
                   request.resource.data.displayName.size() <= 120))
              && (!('email' in request.resource.data) ||
                  (request.resource.data.email is string &&
                   request.resource.data.email.size() <= 254)));
        // Revocation preserves the membership and its audit history.
        allow delete: if false;
      }

      // ===== SUPPLIERS =====
      match /suppliers/{supplierId} {
        allow read: if isMemberOf(orgId);
        allow create: if isSupervisorOrAdmin(orgId);
        allow update: if isSupervisorOrAdmin(orgId);
        allow delete: if isOrgAdmin(orgId);
      }

      // ===== PRODUCTS =====
      match /products/{productId} {
        allow read: if isMemberOf(orgId);
        allow create: if isSupervisorOrAdmin(orgId);
        allow update: if isSupervisorOrAdmin(orgId);
        allow delete: if isOrgAdmin(orgId);
      }

      // ===== CONVERSIONS =====
      match /conversions/{conversionId} {
        allow read: if isMemberOf(orgId);
        allow create, update: if isSupervisorOrAdmin(orgId);
        allow delete: if isOrgAdmin(orgId);
      }

      // ===== PURCHASE ORDERS =====
      match /purchase_orders/{poId} {
        allow read: if isMemberOf(orgId) && canAccessWarehouse(orgId, resource.data.warehouseId);
        allow create: if isMemberOf(orgId) &&
          canAccessWarehouse(orgId, request.resource.data.warehouseId) &&
          isOperatorOrAbove(orgId);
        allow update: if isMemberOf(orgId) &&
          canAccessWarehouse(orgId, resource.data.warehouseId) &&
          warehouseAssignmentUnchanged() &&
          isSupervisorOrAdmin(orgId);
        allow delete: if isOrgAdmin(orgId);
      }

      // ===== RECEPTIONS (CORE) =====
      match /receptions/{receptionId} {
        function isValidReception(data) {
          return data.keys().hasAll([
              'id', 'organizationId', 'warehouseId', 'status', 'operationId',
              'actorUserId', 'createdAt', 'updatedAt'
            ]) &&
            data.keys().hasOnly([
              'id', 'organizationId', 'warehouseId', 'evidenceId', 'folio',
              'scheduledDate', 'purchaseOrderId', 'purchaseOrderNumber',
              'supplierId', 'supplierCode', 'supplierName', 'logisticsProvider',
              'productName', 'palletCount', 'plannedPallets', 'version',
              'status', 'operationId', 'receivedAt', 'actorUserId',
              'evidencePhotos', 'invoicePreviewPath', 'invoicePreviewUrl',
              'draftExpiresAt', 'createdAt', 'updatedAt',
              'cancelledFromStatus', 'cancelledAt', 'cancelledBy', 'hiddenAt', 'hiddenBy'
            ]) &&
            data.id == receptionId &&
            data.organizationId == orgId &&
            data.warehouseId is string && data.warehouseId.size() > 0 &&
            data.warehouseId.size() <= 100 &&
            data.status in ['DRAFT', 'IN_PROGRESS', 'CONFIRMED', 'CANCELLED'] &&
            data.operationId is string && data.operationId.size() > 0 &&
            data.operationId.size() <= 160 &&
            data.actorUserId is string && data.actorUserId.size() > 0 &&
            data.actorUserId.size() <= 128 &&
            data.createdAt is timestamp && data.updatedAt is timestamp &&
            (!('evidenceId' in data) || (data.evidenceId is string && data.evidenceId.size() <= 160)) &&
            (!('folio' in data) || (data.folio is string && data.folio.size() <= 160)) &&
            (!('scheduledDate' in data) || (data.scheduledDate is string && data.scheduledDate.size() <= 64)) &&
            (!('purchaseOrderId' in data) ||
              (data.purchaseOrderId is string && data.purchaseOrderId.size() <= 128)) &&
            (!('purchaseOrderNumber' in data) ||
              (data.purchaseOrderNumber is string && data.purchaseOrderNumber.size() <= 128)) &&
            (!('supplierId' in data) ||
              (data.supplierId is string && data.supplierId.size() <= 128)) &&
            (!('supplierCode' in data) || (data.supplierCode is string && data.supplierCode.size() <= 128)) &&
            (!('supplierName' in data) || (data.supplierName is string && data.supplierName.size() <= 256)) &&
            (!('logisticsProvider' in data) ||
              (data.logisticsProvider is string && data.logisticsProvider.size() <= 256)) &&
            (!('productName' in data) || (data.productName is string && data.productName.size() <= 256)) &&
            (!('palletCount' in data) || (data.palletCount is number && data.palletCount >= 0 && data.palletCount <= 500)) &&
            (!('version' in data) || (data.version is number && data.version >= 0)) &&
            (!('receivedAt' in data) || data.receivedAt is timestamp) &&
            (!('draftExpiresAt' in data) || data.draftExpiresAt is timestamp) &&
            (!('plannedPallets' in data) ||
              (data.plannedPallets is list && data.plannedPallets.size() <= 500)) &&
            (!('evidencePhotos' in data) ||
              (data.evidencePhotos is map &&
               data.evidencePhotos.keys().hasOnly(['trailer', 'product', 'documentation', 'purchaseOrder', 'supplierInvoice']) &&
               (!('trailer' in data.evidencePhotos) ||
                 (data.evidencePhotos.trailer is string && data.evidencePhotos.trailer.size() <= 2048)) &&
               (!('product' in data.evidencePhotos) ||
                 (data.evidencePhotos.product is string && data.evidencePhotos.product.size() <= 2048)) &&
               (!('documentation' in data.evidencePhotos) ||
                 (data.evidencePhotos.documentation is string && data.evidencePhotos.documentation.size() <= 2048)) &&
               (!('purchaseOrder' in data.evidencePhotos) ||
                 (data.evidencePhotos.purchaseOrder is string && data.evidencePhotos.purchaseOrder.size() <= 2048)) &&
               (!('supplierInvoice' in data.evidencePhotos) ||
                 (data.evidencePhotos.supplierInvoice is string && data.evidencePhotos.supplierInvoice.size() <= 2048)))) &&
            (!('invoicePreviewPath' in data) ||
              (data.invoicePreviewPath is string && data.invoicePreviewPath.size() <= 512)) &&
            (!('invoicePreviewUrl' in data) ||
              (data.invoicePreviewUrl is string && data.invoicePreviewUrl.size() <= 2048)) &&
            (!('cancelledFromStatus' in data) || data.cancelledFromStatus == 'DRAFT') &&
            (!('cancelledAt' in data) || data.cancelledAt is timestamp) &&
            (!('cancelledBy' in data) || (data.cancelledBy is string && data.cancelledBy.size() <= 128)) &&
            (!('hiddenAt' in data) || data.hiddenAt is timestamp) &&
            (!('hiddenBy' in data) || (data.hiddenBy is string && data.hiddenBy.size() <= 128));
        }

        function isValidDraftPreviewUpdate() {
          return resource.data.status == 'DRAFT' &&
            request.resource.data.status == 'DRAFT' &&
            request.auth.uid == resource.data.actorUserId &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['invoicePreviewPath', 'invoicePreviewUrl', 'updatedAt']) &&
            (!('invoicePreviewPath' in request.resource.data) ||
              request.resource.data.invoicePreviewPath.matches('^receptions/' + receptionId + '/invoice-preview\\.(jpg|jpeg)$')) &&
            (!('invoicePreviewUrl' in request.resource.data) ||
              request.resource.data.invoicePreviewUrl.matches('^https://firebasestorage\\.googleapis\\.com/.*'));
        }

        allow read: if isMemberOf(orgId) && canAccessWarehouse(orgId, resource.data.warehouseId);

        // Create: operators can create draft receptions
        allow create: if isMemberOf(orgId) &&
          canAccessWarehouse(orgId, request.resource.data.warehouseId) &&
          isOperatorOrAbove(orgId) &&
          request.resource.data.status == 'DRAFT' &&
          request.resource.data.actorUserId == request.auth.uid &&
          isValidReception(request.resource.data);

        // Update: state transitions controlled by role
        allow update: if isMemberOf(orgId) &&
          canAccessWarehouse(orgId, resource.data.warehouseId) &&
          warehouseAssignmentUnchanged() &&
          (
            // Schema-validated lifecycle and draft-preview updates.
            (isValidReception(request.resource.data) &&
             ((isOperatorOrAbove(orgId) && isValidDraftPreviewUpdate()) ||
              // Operators can advance: DRAFT -> IN_PROGRESS -> CONFIRMED
              (isOperatorOrAbove(orgId) &&
               request.resource.data.status in ['IN_PROGRESS', 'CONFIRMED'] &&
               request.resource.data.status != 'CANCELLED' &&
               // Can't go backwards
               ((resource.data.status == 'DRAFT' && request.resource.data.status == 'IN_PROGRESS' &&
                 hasOnlyChanged(['status', 'updatedAt'])) ||
                (resource.data.status == 'IN_PROGRESS' && request.resource.data.status == 'CONFIRMED' &&
                 hasOnlyChanged(['status', 'receivedAt', 'updatedAt'])))))) ||
            // Operators can update plannedPallets when capturing pallets during IN_PROGRESS.
            // This branch intentionally validates only the capture patch so legacy reception
            // documents with fields outside the current schema remain writable.
            (isOperatorOrAbove(orgId) &&
             resource.data.status == 'IN_PROGRESS' &&
             request.resource.data.status == 'IN_PROGRESS' &&
             request.resource.data.id == resource.data.id &&
             request.resource.data.organizationId == resource.data.organizationId &&
             request.resource.data.warehouseId == resource.data.warehouseId &&
             request.resource.data.plannedPallets is list &&
             request.resource.data.plannedPallets.size() <= 500 &&
             (hasOnlyChanged(['plannedPallets']) || hasOnlyChanged(['plannedPallets', 'updatedAt'])))
          );

        // Cancellation, hiding and deletion require audited backend commands.
        allow delete: if false;

        // ---- SUB-COLLECTION: LINES ----
        match /lines/{lineId} {
          allow read: if isMemberOf(orgId) && canAccessWarehouse(orgId,
            get(/databases/$(database)/documents/organizations/$(orgId)/receptions/$(receptionId)).data.warehouseId);
          allow create: if isMemberOf(orgId) &&
            canAccessWarehouse(orgId,
              getAfter(/databases/$(database)/documents/organizations/$(orgId)/receptions/$(receptionId)).data.warehouseId) &&
            request.resource.data.id == lineId &&
            request.resource.data.organizationId == orgId &&
            request.resource.data.receptionId == receptionId &&
            isOperatorOrAbove(orgId);
          allow update, delete: if isMemberOf(orgId) &&
            canAccessWarehouse(orgId,
              get(/databases/$(database)/documents/organizations/$(orgId)/receptions/$(receptionId)).data.warehouseId) &&
            resource.data.id == lineId &&
            resource.data.organizationId == orgId &&
            resource.data.receptionId == receptionId &&
            isSupervisorOrAdmin(orgId);
        }

        // ---- SUB-COLLECTION: PALLETS (QR) ----
        match /pallets/{palletId} {
          allow get: if resource.data.organizationId == orgId &&
            isMemberOf(orgId) && canAccessWarehouse(orgId, resource.data.warehouseId);
          allow list: if resource.data.organizationId == orgId &&
            isMemberOf(orgId) && canAccessWarehouse(orgId, resource.data.warehouseId) &&
            isBoundedPalletQuery();
          allow create: if isMemberOf(orgId) &&
            canAccessWarehouse(orgId,
              getAfter(/databases/$(database)/documents/organizations/$(orgId)/receptions/$(receptionId)).data.warehouseId) &&
            request.resource.data.id == palletId &&
            request.resource.data.organizationId == orgId &&
            request.resource.data.receptionId == receptionId &&
            request.resource.data.warehouseId ==
              getAfter(/databases/$(database)/documents/organizations/$(orgId)/receptions/$(receptionId)).data.warehouseId &&
            isOperatorOrAbove(orgId) &&
            !('shipmentId' in request.resource.data) &&
            // QR identifier must be unique (validated by unique index)
            request.resource.data.qrIdentifier != '';
          allow update: if isMemberOf(orgId) &&
            canAccessWarehouse(orgId, resource.data.warehouseId) &&
            warehouseAssignmentUnchanged() &&
            resource.data.id == palletId &&
            resource.data.organizationId == orgId &&
            resource.data.receptionId == receptionId &&
            shipmentClaimUnchanged() &&
            // Pallet identity, product, quantity, lot, expiry and lifecycle
            // state are inventory facts. Client writes may not rewrite them.
            hasOnlyChanged(['updatedAt']) &&
            isOperatorOrAbove(orgId);
          allow delete: if isSupervisorOrAdmin(orgId);
        }
      }

      // ===== COLLECTION GROUP: PALLETS (for QR lookup) =====
      // Allows reading pallets by qrIdentifier across all receptions
      match /{path=**}/pallets/{palletId} {
        allow get: if resource.data.organizationId == orgId &&
          isMemberOf(orgId) && canAccessWarehouse(orgId, resource.data.warehouseId);
        allow list: if resource.data.organizationId == orgId &&
          isMemberOf(orgId) && canAccessWarehouse(orgId, resource.data.warehouseId) &&
          isBoundedPalletQuery();
      }

      // ===== INVENTORY MOVEMENTS (IMMUTABLE AFTER CREATE) =====
      match /inventory_movements/{movementId} {
        allow read: if isMemberOf(orgId) && canAccessWarehouse(orgId, resource.data.warehouseId);
        // Append-only inventory is written by trusted backend transactions;
        // never trust a client-provided actorUserId or movement direction.
        allow create, update, delete: if false;
      }

      // Deterministic transaction locks used to serialize shipment completion
      // for a warehouse/product pair. They contain no business inventory data.
      match /inventory_locks/{lockId} {
        allow read: if isMemberOf(orgId) &&
          isValidWarehouseId(resource.data.warehouseId);
        allow create: if isSupervisorOrAdmin(orgId) &&
          isValidWarehouseId(request.resource.data.warehouseId);
        allow update: if isSupervisorOrAdmin(orgId) &&
          isValidWarehouseId(resource.data.warehouseId) &&
          warehouseAssignmentUnchanged();
        allow delete: if isOrgAdmin(orgId);
      }

      // ===== INVENTORY SNAPSHOTS =====
      match /inventory/{inventoryId} {
        allow read: if isMemberOf(orgId) && canAccessWarehouse(orgId, resource.data.warehouseId);
        allow create: if isSupervisorOrAdmin(orgId) &&
          isValidWarehouseId(request.resource.data.warehouseId);
        allow update: if isSupervisorOrAdmin(orgId) &&
          canAccessWarehouse(orgId, resource.data.warehouseId) &&
          warehouseAssignmentUnchanged();
        allow delete: if isOrgAdmin(orgId);
      }

      // ===== MONTHLY INVENTORY AGGREGATE =====
      match /inventoryMonthly/{monthlyId} {
        function isValidMonthlyAggregate(data, monthlyId) {
          return data.keys().hasAll([
              'id', 'warehouseId', 'productId', 'year', 'month',
              'cajas', 'tarimas', 'updatedAt', 'updatedBy'
            ]) &&
            data.keys().hasOnly([
              'id', 'warehouseId', 'productId', 'year', 'month',
              'cajas', 'tarimas', 'updatedAt', 'updatedBy'
            ]) &&
            data.id == monthlyId &&
            data.warehouseId is string && data.warehouseId.size() > 0 &&
            data.warehouseId.size() <= 100 &&
            data.productId is string && data.productId.size() <= 128 &&
            data.year is int && data.year >= 2000 && data.year <= 2100 &&
            data.month is int && data.month >= 1 && data.month <= 12 &&
            data.cajas is number &&
            data.tarimas is number &&
            data.updatedAt is timestamp &&
            data.updatedBy is string && data.updatedBy.size() <= 128;
        }

        // Reception transactions call transaction.get() before the document
        // exists, so a missing document must stay readable within scope.
        allow read: if isMemberOf(orgId) &&
          (resource == null || canAccessWarehouse(orgId, resource.data.warehouseId));
        allow create: if isOperatorOrAbove(orgId) &&
          canAccessWarehouse(orgId, request.resource.data.warehouseId) &&
          isValidMonthlyAggregate(request.resource.data, monthlyId);
        allow update: if isOperatorOrAbove(orgId) &&
          canAccessWarehouse(orgId, request.resource.data.warehouseId) &&
          warehouseAssignmentUnchanged() &&
          hasOnlyChanged(['cajas', 'tarimas', 'updatedAt', 'updatedBy']);
        allow delete: if isOrgAdmin(orgId);
      }

      // ===== EXPIRY LOTS =====
      match /lotes_caducidades/{lotId} {
        allow read: if isMemberOf(orgId) && canAccessWarehouse(orgId, resource.data.warehouseId);
        allow create: if isOperatorOrAbove(orgId) &&
          canAccessWarehouse(orgId, request.resource.data.warehouseId);
        allow update: if isOperatorOrAbove(orgId) &&
          canAccessWarehouse(orgId, resource.data.warehouseId) &&
          warehouseAssignmentUnchanged();
        allow delete: if isSupervisorOrAdmin(orgId);
      }

      // ===== AUDIT EVENTS =====
      match /audit_events/{eventId} {
        allow read: if hasRole(orgId, ['AUDITOR', 'SUPERVISOR', 'ADMIN']);
        // Audit records are emitted by trusted backend transactions only.
        allow create, update, delete: if false;
      }

      // ===== SHIPMENTS (EMBARQUES) =====
      match /shipments/{shipmentId} {
        allow read: if isMemberOf(orgId) && canAccessWarehouse(orgId, resource.data.warehouseId);
        allow create: if isMemberOf(orgId) &&
          canAccessWarehouse(orgId, request.resource.data.warehouseId) &&
          isOperatorOrAbove(orgId) &&
          request.resource.data.status == 'PROGRAMMED';
        allow update: if isMemberOf(orgId) &&
          canAccessWarehouse(orgId, resource.data.warehouseId) &&
          warehouseAssignmentUnchanged() &&
          isOperatorOrAbove(orgId) &&
          ((resource.data.status == 'PROGRAMMED' && request.resource.data.status == 'PROGRAMMED' &&
            hasOnlyChanged([
              'folio', 'cliente', 'bodega', 'lines', 'tarimasEscaneadas',
              'evidencia', 'paso', 'fechaProgramada', 'updatedAt'
            ])) ||
           (hasOnlyChanged(['status', 'lines', 'updatedAt']) &&
             (resource.data.status == 'PROGRAMMED' && request.resource.data.status == 'IN_PROGRESS')));
        allow delete: if isOrgAdmin(orgId);
      }

      // ===== EVIDENCES =====
      match /evidences/{evidenceId} {
        allow read: if isMemberOf(orgId);
        allow create: if isMemberOf(orgId) &&
          isOperatorOrAbove(orgId);
        allow update: if isMemberOf(orgId) &&
          isSupervisorOrAdmin(orgId);
        allow delete: if isOrgAdmin(orgId);
      }

      // ===== LABELING BATCHES (PILOTO-1) =====
      match /labelingBatches/{batchId} {
        allow read: if isMemberOf(orgId) &&
          canAccessWarehouse(orgId, resource.data.warehouseId);
        allow create: if isMemberOf(orgId) &&
          canAccessWarehouse(orgId, request.resource.data.warehouseId) &&
          isOperatorOrAbove(orgId) &&
          request.resource.data.status == 'DRAFT';
        allow update: if isMemberOf(orgId) &&
          canAccessWarehouse(orgId, resource.data.warehouseId) &&
          warehouseAssignmentUnchanged() &&
          isOperatorOrAbove(orgId);
        allow delete: if isOrgAdmin(orgId);
      }

      // ===== LABELING BATCH LINES =====
      match /labelingBatches/{batchId}/lines/{lineId} {
        allow read: if isMemberOf(orgId) &&
          canAccessWarehouse(orgId,
            get(/databases/$(database)/documents/organizations/$(orgId)/labelingBatches/$(batchId)).data.warehouseId);
        allow create: if isMemberOf(orgId) &&
          canAccessWarehouse(orgId,
            getAfter(/databases/$(database)/documents/organizations/$(orgId)/labelingBatches/$(batchId)).data.warehouseId) &&
          request.resource.data.id == lineId &&
          request.resource.data.organizationId == orgId &&
          request.resource.data.batchId == batchId &&
          isOperatorOrAbove(orgId);
        allow update, delete: if isMemberOf(orgId) &&
          canAccessWarehouse(orgId,
            get(/databases/$(database)/documents/organizations/$(orgId)/labelingBatches/$(batchId)).data.warehouseId) &&
          resource.data.id == lineId &&
          resource.data.organizationId == orgId &&
          resource.data.batchId == batchId &&
          isSupervisorOrAdmin(orgId);
      }
    }
  }
}
