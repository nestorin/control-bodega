rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Firestore is the metadata authority; object names alone never grant access.
    // A rules evaluation receives the membership data once per authorization
    // branch. Re-fetching it through nested helpers can exhaust the Storage
    // rules expression budget before a valid upload is evaluated.
    function membership(orgId) {
      return request.auth == null ? null :
        firestore.get(/databases/(default)/documents/organizations/$(orgId)/users/$(request.auth.uid)).data;
    }

    function hasActiveMembership(member, orgId) {
      return request.auth != null && member != null &&
        member.userId == request.auth.uid &&
        member.organizationId == orgId && member.status == 'ACTIVE';
    }

    // The backend grants SUPER_ADMIN through a trusted Auth custom claim.
    function hasSuperAdminClaim(orgId) {
      return orgId == 'org_exepa_001' && request.auth != null &&
        ('superAdmin' in request.auth.token) && request.auth.token.superAdmin == true;
    }

    function membershipHasWarehouseAccess(member, warehouseId) {
      return member.role in ['SUPER_ADMIN', 'ADMIN'] ||
        member.warehouseId == warehouseId ||
        (member.warehouseIds is list && member.warehouseIds.hasAny([warehouseId]));
    }

    function hasWarehouseAccess(orgId, warehouseId) {
      let member = membership(orgId);
      return hasSuperAdminClaim(orgId) ||
        (hasActiveMembership(member, orgId) && membershipHasWarehouseAccess(member, warehouseId));
    }

    function hasRole(orgId, roles) {
      let member = membership(orgId);
      return (hasSuperAdminClaim(orgId) && roles.hasAny(['SUPER_ADMIN'])) ||
        (hasActiveMembership(member, orgId) && member.role in roles);
    }

    function receptionIsInScope(orgId, warehouseId, receptionId) {
      let reception = firestore.get(/databases/(default)/documents/organizations/$(orgId)/receptions/$(receptionId));
      return reception.data != null && reception.data.organizationId == orgId &&
        reception.data.warehouseId == warehouseId;
    }

    function validEvidenceUpload() {
      return request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function validDocumentUpload() {
      return request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
    }

    // Canonical path. The warehouse segment is checked against the reception document.
    match /organizations/{orgId}/warehouses/{warehouseId}/receptions/{receptionId}/evidence/{fileName} {
      allow read: if receptionIsInScope(orgId, warehouseId, receptionId) &&
        (fileName.matches('^(invoice-preview|trailer|product|documentation)\\.(jpg|jpeg|png|webp)$') ||
         fileName == 'documentation.pdf');
      allow create, update: if receptionIsInScope(orgId, warehouseId, receptionId) &&
        hasRole(orgId, ['SUPER_ADMIN', 'ADMIN', 'GERENTE_ALMACEN', 'AUXILIAR_ALMACENISTA', 'ALMACENISTA', 'SUPERVISOR', 'OPERATOR']) &&
        fileName.matches('^(invoice-preview|trailer|product|documentation)\\.(jpg|jpeg|png|webp)$') && validEvidenceUpload();
      allow create, update: if receptionIsInScope(orgId, warehouseId, receptionId) &&
        hasRole(orgId, ['SUPER_ADMIN', 'ADMIN', 'GERENTE_ALMACEN', 'AUXILIAR_ALMACENISTA', 'ALMACENISTA', 'SUPERVISOR', 'OPERATOR']) &&
        fileName == 'documentation.pdf' && validDocumentUpload();
      allow delete: if receptionIsInScope(orgId, warehouseId, receptionId) &&
        hasRole(orgId, ['SUPER_ADMIN', 'ADMIN', 'GERENTE_ALMACEN', 'SUPERVISOR']);
    }

    // Legacy compatibility path, bounded while clients migrate to the canonical path.
    match /receptions/{receptionId}/invoice-preview.jpg {
      allow read: if (hasActiveMembership(membership('org_exepa_001'), 'org_exepa_001') || hasSuperAdminClaim('org_exepa_001')) &&
        firestore.get(/databases/(default)/documents/organizations/org_exepa_001/receptions/$(receptionId)).data.actorUserId == request.auth.uid;
      allow create, update: if hasRole('org_exepa_001', ['SUPER_ADMIN', 'ADMIN', 'GERENTE_ALMACEN', 'AUXILIAR_ALMACENISTA', 'ALMACENISTA', 'SUPERVISOR', 'OPERATOR']) &&
        firestore.get(/databases/(default)/documents/organizations/org_exepa_001/receptions/$(receptionId)).data.actorUserId == request.auth.uid && validEvidenceUpload();
      allow delete: if hasRole('org_exepa_001', ['SUPER_ADMIN', 'ADMIN', 'GERENTE_ALMACEN', 'SUPERVISOR']);
    }
  }
}
