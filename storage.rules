rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Firestore is the metadata authority; object names alone never grant access.
    function membership(orgId) {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/organizations/$(orgId)/users/$(request.auth.uid)).data;
    }

    function hasActiveMembership(orgId) {
      return request.auth != null && membership(orgId) != null &&
        membership(orgId).userId == request.auth.uid &&
        membership(orgId).organizationId == orgId && membership(orgId).status == 'ACTIVE';
    }

    function hasWarehouseAccess(orgId, warehouseId) {
      return hasActiveMembership(orgId) && (
        membership(orgId).role in ['SUPER_ADMIN', 'ADMIN'] ||
        membership(orgId).warehouseId == warehouseId ||
        (membership(orgId).warehouseIds is list && membership(orgId).warehouseIds.hasAny([warehouseId]))
      );
    }

    function hasRole(orgId, roles) {
      return hasActiveMembership(orgId) && membership(orgId).role in roles;
    }

    function receptionIsInScope(orgId, warehouseId, receptionId) {
      let reception = firestore.get(/databases/(default)/documents/organizations/$(orgId)/receptions/$(receptionId));
      return reception.data != null && reception.data.organizationId == orgId &&
        reception.data.warehouseId == warehouseId && hasWarehouseAccess(orgId, warehouseId);
    }

    function validEvidenceUpload() {
      return request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Canonical path. The warehouse segment is checked against the reception document.
    match /organizations/{orgId}/warehouses/{warehouseId}/receptions/{receptionId}/evidence/{fileName} {
      allow read: if receptionIsInScope(orgId, warehouseId, receptionId) &&
        fileName.matches('^(invoice-preview|trailer|product|documentation)\\.(jpg|jpeg|png|webp)$');
      allow create, update: if receptionIsInScope(orgId, warehouseId, receptionId) &&
        hasRole(orgId, ['SUPER_ADMIN', 'ADMIN', 'GERENTE_ALMACEN', 'AUXILIAR_ALMACENISTA', 'SUPERVISOR', 'OPERATOR']) &&
        fileName.matches('^(invoice-preview|trailer|product|documentation)\\.(jpg|jpeg|png|webp)$') && validEvidenceUpload();
      allow delete: if receptionIsInScope(orgId, warehouseId, receptionId) &&
        hasRole(orgId, ['SUPER_ADMIN', 'ADMIN', 'GERENTE_ALMACEN', 'SUPERVISOR']);
    }

    // Legacy compatibility path, bounded while clients migrate to the canonical path.
    match /receptions/{receptionId}/invoice-preview.jpg {
      allow read: if hasActiveMembership('org_exepa_001') &&
        firestore.get(/databases/(default)/documents/organizations/org_exepa_001/receptions/$(receptionId)).data.actorUserId == request.auth.uid;
      allow create, update: if hasRole('org_exepa_001', ['SUPER_ADMIN', 'ADMIN', 'GERENTE_ALMACEN', 'AUXILIAR_ALMACENISTA', 'SUPERVISOR', 'OPERATOR']) &&
        firestore.get(/databases/(default)/documents/organizations/org_exepa_001/receptions/$(receptionId)).data.actorUserId == request.auth.uid && validEvidenceUpload();
      allow delete: if hasRole('org_exepa_001', ['SUPER_ADMIN', 'ADMIN', 'GERENTE_ALMACEN', 'SUPERVISOR']);
    }
  }
}
