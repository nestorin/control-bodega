# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Feature Flags (set to 'true' to enable per domain)
# Rollout order: CATALOGOS -> RECEPCIONES/EVIDENCIAS -> INVENTARIO -> LOTES/EMBARQUES -> OFFLINE_QUEUE
VITE_FIRESTORE_CATALOGOS=false
VITE_FIRESTORE_RECEPCIONES=false
VITE_FIRESTORE_EVIDENCIAS=false
VITE_FIRESTORE_INVENTARIO=false
VITE_FIRESTORE_LOTES=false
VITE_FIRESTORE_EMBARQUES=false
VITE_FIRESTORE_OFFLINE_QUEUE=false