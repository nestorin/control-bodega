# Single source of truth for the Firestore domain feature flags.
# The production Hosting build AND the E2E build both consume this file, so the
# configuration the E2E suite validates is the configuration production ships.
# Every flag must be listed explicitly because an undefined flag resolves to
# false in the built bundle and silently disables its domain.
VITE_FIRESTORE_CATALOGOS=true
VITE_FIRESTORE_LABELING_CATALOGOS=true
VITE_FIRESTORE_RECEPCIONES=true
VITE_FIRESTORE_EVIDENCIAS=true
VITE_FIRESTORE_INVENTARIO=true
VITE_FIRESTORE_LOTES=true
VITE_FIRESTORE_EMBARQUES=true
VITE_FIRESTORE_OFFLINE_QUEUE=true
