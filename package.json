{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "node scripts/build-e2e.mjs",
    "preview": "vite preview",
    "format": "oxfmt",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "sh scripts/e2e-preflight.sh && playwright test",
    "test:e2e:ui": "sh scripts/e2e-preflight.sh && playwright test --ui",
    "test:e2e:headed": "sh scripts/e2e-preflight.sh && playwright test --headed",
    "test:all": "npm run test:run && npm run test:e2e",
    "test:rules": "sh scripts/e2e-preflight.sh && firebase emulators:exec --only firestore --project demo-exepa-rules \"pnpm vitest run --config vitest.rules.config.ts\"",
    "seed:warehouses": "tsx scripts/seed-warehouses.ts",
    "seed:suppliers": "tsx scripts/seed-suppliers.ts",
    "migrate:supplier-types": "tsx scripts/migrate-supplier-types.ts",
    "seed:conversions": "tsx scripts/seed-conversions.ts",
    "lint": "oxfmt --check",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "seed:expiries": "tsx scripts/seed-expiries.ts",
    "audit:legacy": "tsx scripts/audit-legacy-firestore.ts"
  },
  "dependencies": {
    "@sentry/react": "^11.4.0",
    "@sentry/tracing": "^7.120.4",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "firebase": "^12.19.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.51.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react-router-dom": "^7.18.4",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "cross-env": "^10.1.0",
    "firebase-admin": "^14.5.0",
    "jsdom": "^30.1.1",
    "msw": "^3.0.1",
    "oxfmt": "^0.2.0",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.3"
  }
}
